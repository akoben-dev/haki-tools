---
import Base from '../../layouts/Base.astro';
import { getEntry } from 'astro:content';
const success = (await getEntry('copy', 'contact'))!.data.success!;
---
<Base title="Message sent" noindex>
  <article class="page prose">
    <h1>{success.heading}</h1>
    <p class="meta">{success.body}</p>
    <p style="margin-top:32px"><a class="btn btn-ghost" href="/">Back to the home page</a></p>
  </article>
</Base>
