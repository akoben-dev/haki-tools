---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <article class="page prose">
    <p class="eyebrow">404</p>
    <h1>This page doesn't exist.</h1>
    <p class="meta">The link may be old, or the address may have a typo.</p>
    <p style="margin-top:32px"><a class="btn btn-primary" href="/">Back to the home page</a></p>
  </article>
</Base>
