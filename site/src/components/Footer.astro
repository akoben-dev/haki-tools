---
import { site } from '../config/site';
import { inlineSvg } from '../lib/svg';
import wordmark from '../assets/brand/haki-horizontal.svg?raw';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" aria-label={`${site.name}, home`} set:html={inlineSvg(wordmark, site.name)} />
      <p>{site.tagline} {site.locationLine}</p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        <li><a href="/services">Services</a></li>
        <li><a href="/#process">Process</a></li>
        <li><a href="/#faq">FAQ</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
    </div>
    <div>
      <h2>Legal</h2>
      <ul>
        <li><a href="/privacy">Privacy policy</a></li>
        <li><a href="/rvrmmo/privacy">RVRMMO privacy policy</a></li>
      </ul>
    </div>
    <small>© {year} {site.legalName}. All rights reserved.</small>
  </div>
</footer>
